# Mirevox Stage-gate — runtime env (no secrets required for v1)
#
# Copy to `.env` only if you want to override defaults locally:
#   cp .env.example .env
#
# Docker Compose reads STAGE_GATE_PORT for the host publish mapping.

# Host port published by docker compose (container always listens on 3847)
STAGE_GATE_PORT=3847

# Used by `next start` / the standalone server inside the image
PORT=3847
HOSTNAME=0.0.0.0
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
